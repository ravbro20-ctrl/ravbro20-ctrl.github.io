    <button class="theme-toggle" id="themeToggle" title="Сменить тему">&#9790;</button>

    <!-- Кнопка «Наверх» -->
    <button id="toTop" title="Наверх" aria-label="Наверх">&#8593;</button>

    <script>
        // ===== Фейковая загрузка =====
        const loader = document.getElementById('loader');
        const loaderFill = document.getElementById('loaderFill');
        const loaderPercent = document.getElementById('loaderPercent');
        let loaderProgress = 0;
        const loaderTick = setInterval(() => {
            loaderProgress += Math.random() * 18 + 4;
            if (loaderProgress >= 100) {
                loaderProgress = 100;
                clearInterval(loaderTick);
                loaderFill.style.width = '100%';
                loaderPercent.textContent = '100';
                // мгновенно в самый верх, даже если пользователь листал во время загрузки
                window.scrollTo(0, 0);
                setTimeout(() => {
                    loader.classList.add('hide');
                    setTimeout(() => loader.remove(), 700);
                }, 350);
            } else {
                loaderFill.style.width = loaderProgress + '%';
                loaderPercent.textContent = Math.floor(loaderProgress);
            }
        }, 200);

        const toggle = document.getElementById('themeToggle');
        toggle.addEventListener('click', () => {
            document.body.classList.toggle('dark');
            const isDark = document.body.classList.contains('dark');
            toggle.innerHTML = isDark ? '&#9728;' : '&#9790;';
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });

        if (localStorage.getItem('theme') === 'dark') {
            document.body.classList.add('dark');
            toggle.innerHTML = '&#9728;';
        }

        // ===== Кнопка «Наверх» =====
        const toTopBtn = document.getElementById('toTop');
        window.addEventListener('scroll', () => {
            toTopBtn.classList.toggle('show', window.scrollY > 300);
        });
        toTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // ===== Счётчик открытий сайта (хранится в браузере) =====
        const visits = (parseInt(localStorage.getItem('siteVisits') || '0', 10) + 1);
        localStorage.setItem('siteVisits', String(visits));
        document.getElementById('visitCount').textContent = visits;

        // ===== Количество строк кода =====
        // строки HTML считаются автоматически, CSS посчитан отдельно
        const htmlLines = document.documentElement.outerHTML.split('\n').length;
        const cssLines = 740; // style.css
        document.getElementById('lineCount').textContent = htmlLines + cssLines;

        const aboutCards = document.querySelectorAll('#about .card.clickable');
        const aboutContainer = document.getElementById('aboutCards');

        // плавно раскрываем текст внутри карточки (высота + прозрачность)
        function revealDetails(card) {
            const details = card.querySelector('.card-details');
            details.style.display = 'block';
            details.style.maxHeight = '0px';
            details.style.opacity = '0';
            void details.offsetWidth;
            details.style.transition = 'max-height 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease';
            details.style.maxHeight = details.scrollHeight + 'px';
            details.style.opacity = '1';
            setTimeout(() => {
                details.style.maxHeight = 'none';
                details.style.transition = '';
                details.style.opacity = '';
            }, 700);
        }

        // плавно сворачиваем текст внутри карточки
        function hideDetails(card) {
            const details = card.querySelector('.card-details');
            // переводим высоту в пиксели, чтобы max-height могла плавно анимироваться
            details.style.transition = 'none';
            details.style.maxHeight = details.scrollHeight + 'px';
            details.style.opacity = '1';
            void details.offsetWidth;
            details.style.transition = 'max-height 0.4s ease, opacity 0.4s ease';
            details.style.maxHeight = '0px';
            details.style.opacity = '0';
            setTimeout(() => {
                details.style.display = 'none';
                details.style.maxHeight = '';
                details.style.opacity = '';
                details.style.transition = '';
            }, 420);
        }

        function flipCard(card, open, then) {
            const first = card.getBoundingClientRect();

            if (open) {
                // прячем текст до конца полёта, чтобы он не появлялся мгновенно
                const details = card.querySelector('.card-details');
                details.style.transition = 'none';
                details.style.display = 'none';
                details.style.maxHeight = '';
                details.style.opacity = '';
                aboutContainer.classList.add('has-active');
                card.classList.add('active');
                card.title = 'Нажми повторно, чтобы скрыть';
            } else {
                aboutContainer.classList.remove('has-active');
                card.classList.remove('active');
                card.title = 'Нажми, чтобы раскрыть';

                // остальные карточки плавно возвращаются на места
                aboutCards.forEach((s) => {
                    if (s === card || s.classList.contains('active')) return;
                    s.classList.remove('reappear');
                    void s.offsetWidth;
                    s.classList.add('reappear');
                    setTimeout(() => s.classList.remove('reappear'), 550);
                });
            }

            const last = card.getBoundingClientRect();
            const dx = first.left - last.left;
            const dy = first.top - last.top;
            const sx = first.width / last.width;
            const sy = first.height / last.height;

            card.style.transition = 'none';
            card.style.transformOrigin = 'top left';
            card.style.transform = 'translate(' + dx + 'px, ' + dy + 'px) scale(' + sx + ', ' + sy + ')';
            void card.offsetWidth; // принудительный reflow

            card.style.transition = 'transform 0.55s cubic-bezier(0.22, 1, 0.36, 1)';
            card.style.transform = '';
            setTimeout(() => {
                card.style.transition = '';
                card.style.transform = '';
                if (then) then();
            }, 580);
        }

        aboutCards.forEach((card) => {
            card.addEventListener('click', () => {
                const isOpen = card.classList.contains('active');

                // закрываем остальные открытые карточки
                aboutCards.forEach((c) => {
                    if (c !== card && c.classList.contains('active')) {
                        hideDetails(c);
                        setTimeout(() => flipCard(c, false), 420);
                    }
                });

                // сворачиваем или разворачиваем нажатую
                if (isOpen) {
                    hideDetails(card);
                    setTimeout(() => flipCard(card, false), 420);
                } else {
                    // сначала карточка летит в угол, потом текст плавно опускается
                    flipCard(card, true, () => revealDetails(card));
                }
            });
        });
    </script>

